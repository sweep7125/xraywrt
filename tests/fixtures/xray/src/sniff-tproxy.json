{
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ],
  "routing": {
    "rules": [
      {
        "domain": [
          "domain:example.com"
        ],
        "outboundTag": "direct"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "provider-tproxy",
      "protocol": "tunnel",
      "listen": "127.0.0.1",
      "port": 12345,
      "settings": {
        "followRedirect": true,
        "allowedNetwork": "tcp,udp"
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "tls"
        ],
        "routeOnly": false,
        "domainsExcluded": [
          "a.test"
        ]
      }
    },
    {
      "tag": "socks",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 1080,
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http"
        ],
        "metadataOnly": true
      }
    }
  ]
}
