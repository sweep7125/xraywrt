{
  "api": {
    "listen": "/var/run/xraywrt/api.sock,0600",
    "services": [
      "HandlerService",
      "RoutingService",
      "StatsService"
    ],
    "tag": "xraywrt-api"
  },
  "burstObservatory": {
    "pingConfig": {
      "destination": "https://probe.example.com/204",
      "interval": "1m"
    },
    "subjectSelector": [
      "proxy"
    ]
  },
  "dns": {
    "hosts": {
      "router.example.com": "192.168.1.1"
    },
    "queryStrategy": "UseIPv4",
    "servers": [
      {
        "address": "fakedns",
        "domains": [
          "geosite:youtube",
          "domain:example.com",
          "full:api.example.org",
          "keyword:tracker",
          "regexp:^cdn[0-9]+\\.example\\.net$"
        ],
        "queryStrategy": "UseIPv4",
        "skipFallback": true
      },
      "https://dns.example.net/dns-query"
    ],
    "tag": "xraywrt-dns-internal"
  },
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 65535
    }
  ],
  "geodata": {
    "assets": [
      {
        "file": "geosite.dat",
        "url": "https://geo.example.com/geosite.dat"
      }
    ],
    "cron": "0 4 * * *"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "tag": "socks"
    },
    {
      "port": 10809,
      "protocol": "http"
    },
    {
      "listen": "127.0.0.1",
      "port": 7894,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "destOverride": [
          "fakedns"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "tag": "xraywrt-tproxy4"
    },
    {
      "listen": "::1",
      "port": 7894,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "destOverride": [
          "fakedns"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "tag": "xraywrt-tproxy6"
    },
    {
      "listen": "127.0.0.1",
      "port": 7895,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "destOverride": [
          "fakedns"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "tag": "xraywrt-fakeip-direct"
    },
    {
      "listen": "127.0.0.1",
      "port": 7874,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp"
      },
      "tag": "xraywrt-dns-in"
    }
  ],
  "log": {
    "access": "none",
    "dnsLog": false,
    "loglevel": "debug"
  },
  "observatory": {
    "probeInterval": "5m",
    "probeURL": "https://probe.example.com/204",
    "subjectSelector": [
      "proxy"
    ]
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "node.example.com",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "flow": "xtls-rprx-vision",
                "id": "11111111-2222-3333-4444-555555555555"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "realitySettings": {
          "fingerprint": "chrome",
          "publicKey": "Y_9LJMXGRQxqfOd5sGpJ6LVpdqVAo9hTk7HOtd5n3k8",
          "serverName": "www.example.com",
          "shortId": "6ba85179e30d4fc2"
        },
        "security": "reality",
        "sockopt": {
          "mark": 2
        }
      },
      "tag": "proxy"
    },
    {
      "protocol": "freedom",
      "settings": {
        "finalRules": [
          {
            "action": "allow",
            "port": "53"
          },
          {
            "action": "block",
            "ip": [
              "0.0.0.0/8",
              "10.0.0.0/8",
              "100.64.0.0/10",
              "127.0.0.0/8",
              "169.254.0.0/16",
              "172.16.0.0/12",
              "192.0.0.0/24",
              "192.0.2.0/24",
              "192.88.99.0/24",
              "192.168.0.0/16",
              "198.51.100.0/24",
              "203.0.113.0/24",
              "224.0.0.0/3",
              "::/127",
              "fe80::/10",
              "fc00::/7",
              "ff00::/8"
            ]
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "mark": 2
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "streamSettings": {
        "sockopt": {
          "mark": 2
        }
      },
      "tag": "block"
    },
    {
      "protocol": "freedom",
      "settings": {
        "finalRules": [
          {
            "action": "allow",
            "port": "53"
          },
          {
            "action": "block",
            "ip": [
              "0.0.0.0/8",
              "10.0.0.0/8",
              "100.64.0.0/10",
              "127.0.0.0/8",
              "169.254.0.0/16",
              "172.16.0.0/12",
              "192.0.0.0/24",
              "192.0.2.0/24",
              "192.88.99.0/24",
              "192.168.0.0/16",
              "198.51.100.0/24",
              "203.0.113.0/24",
              "224.0.0.0/3",
              "::/127",
              "fe80::/10",
              "fc00::/7",
              "ff00::/8"
            ]
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIP",
          "mark": 2
        }
      },
      "tag": "xraywrt-direct"
    },
    {
      "protocol": "dns",
      "settings": {
        "rules": [
          {
            "action": "resolve"
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "mark": 2
        }
      },
      "tag": "xraywrt-dns"
    }
  ],
  "policy": {
    "levels": {
      "0": {
        "connIdle": 300,
        "handshake": 4
      }
    },
    "system": {
      "statsOutboundUplink": false
    }
  },
  "routing": {
    "balancers": [
      {
        "selector": [
          "proxy"
        ],
        "strategy": {
          "type": "leastPing"
        },
        "tag": "auto"
      }
    ],
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "xraywrt-dns-in"
        ],
        "outboundTag": "xraywrt-dns"
      },
      {
        "inboundTag": [
          "xraywrt-dns-internal"
        ],
        "ip": [
          "127.0.0.1"
        ],
        "outboundTag": "xraywrt-direct",
        "port": 53
      },
      {
        "ip": [
          "198.18.0.0/15"
        ],
        "outboundTag": "block"
      },
      {
        "inboundTag": [
          "xraywrt-fakeip-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "ip": [
          "geoip:private"
        ],
        "outboundTag": "direct"
      },
      {
        "balancerTag": "auto",
        "network": "tcp,udp"
      }
    ]
  },
  "transport": {},
  "vendorExtension": {
    "x": [
      1,
      2,
      {
        "y": null
      }
    ]
  }
}
