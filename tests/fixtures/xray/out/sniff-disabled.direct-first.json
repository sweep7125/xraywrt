{
  "api": {
    "listen": "/var/run/xraywrt/api.sock,0600",
    "services": [
      "HandlerService",
      "RoutingService",
      "StatsService"
    ],
    "tag": "xraywrt-api"
  },
  "dns": {
    "servers": [
      {
        "address": "fakedns",
        "domains": [
          "geosite:youtube",
          "domain:example.com",
          "full:api.example.org",
          "keyword:tracker",
          "regexp:^cdn[0-9]+\\.example\\.net$"
        ],
        "queryStrategy": "UseIPv4",
        "skipFallback": true
      },
      "192.0.2.53"
    ],
    "tag": "xraywrt-dns-internal"
  },
  "fakedns": [
    {
      "ipPool": "198.18.0.0/15",
      "poolSize": 65535
    }
  ],
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 1080,
      "protocol": "socks",
      "sniffing": {
        "destOverride": [
          "tls"
        ],
        "enabled": false,
        "routeOnly": false
      },
      "tag": "socks"
    },
    {
      "listen": "127.0.0.1",
      "port": 7894,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "destOverride": [
          "fakedns"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "tag": "xraywrt-tproxy4"
    },
    {
      "listen": "::1",
      "port": 7894,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "destOverride": [
          "fakedns"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "tag": "xraywrt-tproxy6"
    },
    {
      "listen": "127.0.0.1",
      "port": 7895,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp",
        "followRedirect": true
      },
      "sniffing": {
        "destOverride": [
          "fakedns"
        ],
        "enabled": true,
        "routeOnly": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "tag": "xraywrt-fakeip-direct"
    },
    {
      "listen": "127.0.0.1",
      "port": 7874,
      "protocol": "tunnel",
      "settings": {
        "allowedNetwork": "tcp,udp"
      },
      "tag": "xraywrt-dns-in"
    }
  ],
  "log": {
    "access": "none",
    "dnsLog": false,
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "settings": {
        "finalRules": [
          {
            "action": "allow",
            "port": "53"
          },
          {
            "action": "block",
            "ip": [
              "0.0.0.0/8",
              "10.0.0.0/8",
              "100.64.0.0/10",
              "127.0.0.0/8",
              "169.254.0.0/16",
              "172.16.0.0/12",
              "192.0.0.0/24",
              "192.0.2.0/24",
              "192.88.99.0/24",
              "192.168.0.0/16",
              "198.51.100.0/24",
              "203.0.113.0/24",
              "224.0.0.0/3",
              "::/127",
              "fe80::/10",
              "fc00::/7",
              "ff00::/8"
            ]
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "mark": 2
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "freedom",
      "settings": {
        "finalRules": [
          {
            "action": "allow",
            "port": "53"
          },
          {
            "action": "block",
            "ip": [
              "0.0.0.0/8",
              "10.0.0.0/8",
              "100.64.0.0/10",
              "127.0.0.0/8",
              "169.254.0.0/16",
              "172.16.0.0/12",
              "192.0.0.0/24",
              "192.0.2.0/24",
              "192.88.99.0/24",
              "192.168.0.0/16",
              "198.51.100.0/24",
              "203.0.113.0/24",
              "224.0.0.0/3",
              "::/127",
              "fe80::/10",
              "fc00::/7",
              "ff00::/8"
            ]
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "ForceIP",
          "mark": 2
        }
      },
      "tag": "xraywrt-direct"
    },
    {
      "protocol": "blackhole",
      "tag": "xraywrt-block"
    },
    {
      "protocol": "dns",
      "settings": {
        "rules": [
          {
            "action": "resolve"
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "mark": 2
        }
      },
      "tag": "xraywrt-dns"
    }
  ],
  "routing": {
    "rules": [
      {
        "inboundTag": [
          "xraywrt-dns-in"
        ],
        "outboundTag": "xraywrt-dns"
      },
      {
        "inboundTag": [
          "xraywrt-dns-internal"
        ],
        "ip": [
          "127.0.0.1",
          "192.0.2.53"
        ],
        "outboundTag": "xraywrt-direct",
        "port": 53
      },
      {
        "ip": [
          "198.18.0.0/15"
        ],
        "outboundTag": "xraywrt-block"
      },
      {
        "inboundTag": [
          "xraywrt-fakeip-direct"
        ],
        "outboundTag": "direct"
      },
      {
        "domain": [
          "domain:example.com"
        ],
        "outboundTag": "direct"
      }
    ]
  }
}
