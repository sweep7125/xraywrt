add table inet xraywrt
delete table inet xraywrt
add table inet xraywrt
add set inet xraywrt proxy_dst { type ipv4_addr; flags interval; auto-merge; }
add set inet xraywrt proxy_src { type ipv4_addr; flags interval; auto-merge; }
add set inet xraywrt direct_dst { type ipv4_addr; flags interval; auto-merge; }
add set inet xraywrt direct_src { type ipv4_addr; flags interval; auto-merge; }
add set inet xraywrt localv4 { type ipv4_addr; flags interval; auto-merge; }
add set inet xraywrt proxy_dst6 { type ipv6_addr; flags interval; auto-merge; }
add set inet xraywrt proxy_src6 { type ipv6_addr; flags interval; auto-merge; }
add set inet xraywrt direct_dst6 { type ipv6_addr; flags interval; auto-merge; }
add set inet xraywrt direct_src6 { type ipv6_addr; flags interval; auto-merge; }
add set inet xraywrt localv6 { type ipv6_addr; flags interval; auto-merge; }
add set inet xraywrt proxy_src_mac { type ether_addr; }
add set inet xraywrt direct_src_mac { type ether_addr; }
add set inet xraywrt source_ifaces { type ifname; }
add set inet xraywrt bypass_dst { type ipv4_addr; flags timeout; }
add set inet xraywrt bypass_dst6 { type ipv6_addr; flags timeout; }
add element inet xraywrt localv4 { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 }
add element inet xraywrt localv6 { ::/127, fe80::/10, fc00::/7, ff00::/8 }
add element inet xraywrt localv4 { 203.0.113.0/24 }
add element inet xraywrt localv6 { 2001:db8:1:10::/64 }
add element inet xraywrt localv6 { 2001:db8:1:20::/64 }
add element inet xraywrt localv6 { 2001:db8:1::/48 }
add element inet xraywrt localv6 { 2001:db8:2::/48 }
add element inet xraywrt localv6 { 2001:db8:4::1 }
add element inet xraywrt source_ifaces { "br-lan" }
add chain inet xraywrt dns_hijack { type nat hook prerouting priority dstnat; policy accept; }
add chain inet xraywrt mangle_prerouting { type filter hook prerouting priority mangle; policy accept; }
add chain inet xraywrt prerouting_policy
add chain inet xraywrt mangle_output { type route hook output priority mangle; policy accept; }
add chain inet xraywrt proxy_redirect { type filter hook prerouting priority dstnat; policy accept; }
add chain inet xraywrt api_guard { type filter hook output priority filter; policy accept; }
add element inet xraywrt direct_dst { 77.88.8.8 }
add element inet xraywrt direct_dst6 { 2a02:6b8::/32 }
add element inet xraywrt direct_src { 192.168.1.50 }
add element inet xraywrt direct_src6 { fd00::50 }
add rule inet xraywrt dns_hijack iifname "wt0" return
add rule inet xraywrt dns_hijack fib daddr type local return
add rule inet xraywrt dns_hijack iifname @source_ifaces ip daddr != @localv4 meta l4proto { tcp, udp } th dport 53 redirect to :53
add rule inet xraywrt dns_hijack iifname @source_ifaces ip6 daddr != @localv6 meta l4proto { tcp, udp } th dport 53 redirect to :53
add rule inet xraywrt mangle_prerouting iifname "wt0" return
add rule inet xraywrt mangle_prerouting iifname @source_ifaces jump prerouting_policy
add rule inet xraywrt prerouting_policy ct direction reply return
add rule inet xraywrt prerouting_policy fib daddr type local return
add rule inet xraywrt prerouting_policy ip daddr @localv4 return
add rule inet xraywrt prerouting_policy ip6 daddr @localv6 return
add rule inet xraywrt prerouting_policy meta mark & 0x08000000 == 0x08000000 return
add rule inet xraywrt prerouting_policy meta nfproto ipv6 udp dport 123 return
add rule inet xraywrt prerouting_policy ip daddr != 198.18.0.0/15 udp dport 123 return
add rule inet xraywrt prerouting_policy meta l4proto { tcp, udp } th dport 53 return
add rule inet xraywrt prerouting_policy ip daddr @direct_dst return
add rule inet xraywrt prerouting_policy ip6 daddr @direct_dst6 return
add chain inet xraywrt direct_device_policy
add rule inet xraywrt direct_device_policy meta nfproto ipv6 return
add rule inet xraywrt direct_device_policy ip daddr != 198.18.0.0/15 return
add rule inet xraywrt direct_device_policy ip daddr 198.18.0.0/15 udp dport 443 reject
add rule inet xraywrt direct_device_policy ip daddr 198.18.0.0/15 meta l4proto { tcp, udp } meta mark set meta mark | 0x08000000 | 0x04000000 accept
add rule inet xraywrt prerouting_policy ip saddr @direct_src goto direct_device_policy
add rule inet xraywrt prerouting_policy ip6 saddr @direct_src6 goto direct_device_policy
add rule inet xraywrt prerouting_policy meta l4proto { tcp, udp } meta mark set meta mark | 0x08000000
add rule inet xraywrt prerouting_policy meta mark & 0x08000000 == 0x08000000 udp dport 443 meta mark set meta mark ^ 0x08000000 reject
add rule inet xraywrt proxy_redirect iifname "wt0" return
add rule inet xraywrt proxy_redirect meta mark & 0x04000000 == 0x04000000 meta nfproto ipv4 meta l4proto { tcp, udp } tproxy ip to 127.0.0.1:7895 accept
add rule inet xraywrt proxy_redirect meta mark & 0x08000000 == 0x08000000 meta nfproto ipv4 meta l4proto { tcp, udp } tproxy ip to 127.0.0.1:7894
add rule inet xraywrt proxy_redirect meta mark & 0x08000000 == 0x08000000 meta nfproto ipv6 meta l4proto { tcp, udp } tproxy ip6 to [::1]:7894
add rule inet xraywrt mangle_output meta mark & 0x000000ff == 2 return
add rule inet xraywrt mangle_output ct direction reply return
add rule inet xraywrt mangle_output meta l4proto { tcp, udp } th dport 7894 return
add rule inet xraywrt mangle_output fib daddr type local return
add rule inet xraywrt mangle_output ip daddr @localv4 return
add rule inet xraywrt mangle_output ip6 daddr @localv6 return
add rule inet xraywrt mangle_output meta mark & 0x08000000 == 0x08000000 return
add rule inet xraywrt mangle_output meta nfproto ipv6 udp dport 123 return
add rule inet xraywrt mangle_output ip daddr != 198.18.0.0/15 udp dport 123 return
add rule inet xraywrt mangle_output meta l4proto { tcp, udp } th dport 53 return
add rule inet xraywrt mangle_output ip daddr @bypass_dst return
add rule inet xraywrt mangle_output ip6 daddr @bypass_dst6 return
add rule inet xraywrt mangle_output meta mark & 0x40000000 == 0x40000000 return
add rule inet xraywrt mangle_output meta mark & 0x20000000 == 0x20000000 return
add rule inet xraywrt mangle_output meta nfproto ipv6 meta mark { 0x1bd00, 0x1bd10, 0x1bd11, 0x1bd20, 0x1bd21, 0x1bd22 } return
add rule inet xraywrt mangle_output ip daddr != 198.18.0.0/15 meta mark { 0x1bd00, 0x1bd10, 0x1bd11, 0x1bd20, 0x1bd21, 0x1bd22 } return
add rule inet xraywrt mangle_output udp dport { 67, 547 } return
add rule inet xraywrt mangle_output ip daddr @direct_dst return
add rule inet xraywrt mangle_output ip6 daddr @direct_dst6 return
add rule inet xraywrt mangle_output meta l4proto { tcp, udp } meta mark set meta mark | 0x08000000
add rule inet xraywrt mangle_output meta mark & 0x08000000 == 0x08000000 udp dport 443 meta mark set meta mark ^ 0x08000000 reject
add rule inet xraywrt api_guard meta mark & 0x000000ff == 2 ip daddr 127.0.0.0/8 tcp dport 10085 reject with tcp reset
add rule inet xraywrt api_guard meta mark & 0x000000ff == 2 ip6 daddr ::1 tcp dport 10085 reject with tcp reset
