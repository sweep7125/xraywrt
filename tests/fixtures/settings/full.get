xraywrt.settings.source_network_interfaces=br-lan wg0
xraywrt.settings.provider_override=disable_quic
xraywrt.settings.dns_hijack=off
xraywrt.settings.disable_quic=yes
xraywrt.settings.netbird_proxy=true
xraywrt.settings.bypass_ntp=0
xraywrt.settings.bypass_subscription_dns=0
xraywrt.settings.block_client_ipv6=enabled
xraywrt.settings.netbird_mark=0113920
xraywrt.settings.netbird_interface=nb-test
xraywrt.settings.subscription=sfull
xraywrt.sfull.url=https://example.com/a?b=c
xraywrt.settings.subscription_auto_update=0
xraywrt.settings.lists_interval=08
xraywrt.settings.cron_minute=07
xraywrt.settings.dst_list_source=merge
xraywrt.settings.direct_list_source=own
