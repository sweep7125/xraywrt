POLICY_MODE=direct-first
DNS_MODE=fake-ip
DIRECT_LISTENER=1
PROVIDER_KEYS=disable_quic dns_hijack 
PROVIDER_OVERRIDES=odd's value literal"quote $(false) back\slash
SOURCE_INTERFACES=br-lan
DNS_HIJACK=0
DISABLE_QUIC=0
NETBIRD_PROXY=0
BYPASS_NTP=0
BYPASS_SUBSCRIPTION_DNS=0
BLOCK_CLIENT_IPV6=0
NETBIRD_MARK=113920
NETBIRD_INTERFACE=wt0
SUBSCRIPTION_URL=https://example.com/it's?x=$(false)&y=back\slash
SUBSCRIPTION_INTERVAL=12
LISTS_INTERVAL=0
CRON_MINUTE=17
SETTINGS_LOADED=1
