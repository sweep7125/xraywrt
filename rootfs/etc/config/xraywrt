config settings 'settings'
	option mode 'proxy-first'
	list source_network_interfaces 'br-lan'
	option dns_hijack '0'
	option discord_voice '0'
	option disable_quic '0'
	option netbird_proxy '0'
	option bypass_ntp '0'
	option bypass_subscription_dns '0'
	option block_client_ipv6 '0'
	option subscription_auto_update '1'
	option lists_interval '0'
	option geodata_cron '0 5 * * *'
	option dns_forward_other_types '1'
	option block_https_svcb '0'
	option core_log_level 'warning'
	# balancer_override: no list items means automatic selection (spec 16).
