msgstr "Подписка уже актуальна."

msgid "Unknown:"
msgstr "Неизвестно:"

msgid "Update automatically"
msgstr "Обновлять автоматически"

msgid "Update interval from the subscription: every %d h."
msgstr "По расписанию подписки: каждые %d ч."

msgid "none"
msgstr "нет"

msgid "%s (priority %s)"
msgstr "%s (приоритет %s)"

msgid "(could not read the configuration)"
msgstr "(не удалось прочитать конфигурацию)"

msgid "Configuration has errors"
msgstr "В конфигурации есть ошибки"

msgid "Hide details"
msgstr "Скрыть подробности"

msgid "Hide the log"
msgstr "Скрыть журнал"

msgid "Loading…"
msgstr "Загрузка…"

msgid "Over 90% of the subscription traffic is used."
msgstr "Израсходовано больше 90% трафика подписки."

msgid "Show details"
msgstr "Показать подробности"

msgid "Show the log"
msgstr "Показать журнал"

msgid "Stopped because of an error."
msgstr "Остановлен из-за ошибки."

msgid "What to do: update the subscription or fix the configuration."
msgstr "Что делать: обновите подписку или исправьте конфигурацию."

msgid "Details: %s"
msgstr "Подробности: %s"

msgid "Open Help"
msgstr "Открыть «Помощь»"

msgid "The previous link is kept."
msgstr "Прежняя ссылка сохранена."

msgid "The provider refused access (HTTP %s). The subscription may have expired or the link is wrong."
msgstr "Сервер подписки отказал в доступе (HTTP %s). Возможно, подписка закончилась или ссылка неверна."

msgid "The provider server answered with an error (HTTP %s). Try again later."
msgstr "Сервер подписки ответил ошибкой (HTTP %s). Попробуйте позже."

msgid "Subscription expires on %s. Renew it with the service."
msgstr "Подписка заканчивается %s. Продлите её у сервиса."

msgid "Subscription expired. Renew it with the service."
msgstr "Подписка закончилась. Продлите её у сервиса."

msgid "The subscription is too large."
msgstr "Подписка слишком большая."

msgid "Subscription not found (HTTP 404). Check the link in your service account."
msgstr "Подписка не найдена (HTTP 404). Проверьте ссылку в личном кабинете сервиса."

msgid "The subscription traffic is used up."
msgstr "Трафик подписки закончился."

msgid "The router did not answer in time. The operation may still be running; check again in a minute."
msgstr "Роутер не ответил вовремя. Операция может ещё выполняться; проверьте снова через минуту."

msgid "Access denied. Log in to LuCI again, or ask for write access."
msgstr "Доступ запрещён. Войдите в LuCI снова или попросите права на изменение."

msgid "Another operation is running: \"%s\". Wait until it finishes."
msgstr "Уже выполняется другая операция: «%s». Дождитесь её завершения."

msgid "The operation was interrupted (for example, by a router reboot). You can run it again."
msgstr "Операция прервана (например, перезагрузкой роутера). Её можно запустить снова."

msgid "The subscription returned an empty configuration."
msgstr "Подписка вернула пустую конфигурацию."

msgid "The remote lists are larger than 8 MiB in total. Remove some list links or use smaller lists."
msgstr "Списки по ссылкам занимают больше 8 МБ суммарно. Уберите часть ссылок на списки или используйте меньшие списки."

msgid "Connecting the subscription"
msgstr "Подключение подписки"

msgid "Subscription update"
msgstr "Обновление подписки"

msgid "Remote list update"
msgstr "Обновление списков по ссылкам"

msgid "Applying lists and settings"
msgstr "Применение списков и настроек"

msgid "Starting, stopping or restarting XrayWRT"
msgstr "Запуск, остановка или перезапуск XrayWRT"

msgid "You can close the page — the operation continues on the router."
msgstr "Можно закрыть страницу — операция продолжится на роутере."

msgid "No devices found in DHCP. Enter a MAC address, e.g. aa:bb:cc:dd:ee:ff."
msgstr "В списке DHCP нет устройств. Введите MAC-адрес, например aa:bb:cc:dd:ee:ff."

msgid "Lost connection to the router while waiting for the result."
msgstr "Во время ожидания результата потеряна связь с роутером."

msgid "\"%s\" is running…"
msgstr "Выполняется операция «%s»…"

msgid "\"%s\" failed: %s"
msgstr "«%s» не удалось: %s"

msgid "\"%s\" finished. Reload the page to see the result; your unsaved edits are still here."
msgstr "«%s» завершено. Обновите страницу, чтобы увидеть результат; несохранённые правки пока на месте."

msgid "The operation failed."
msgstr "Операция не выполнена."

msgid "Invalid upload path."
msgstr "Недопустимый путь загрузки."

msgid "The upload was incomplete. Try again."
msgstr "Файл загружен не полностью. Попробуйте снова."

msgid "Unexpected response from the router."
msgstr "Неожиданный ответ роутера."

msgid "Starting…"
msgstr "Запускается…"

msgid "Automatic updates will replace the restored configuration again."
msgstr "Автоматическое обновление снова заменит восстановленную конфигурацию."

msgid "Everything goes via VPN except the addresses and devices below."
msgstr "Через VPN идёт всё, кроме адресов и устройств ниже."

msgid "Only the addresses and devices below, plus the sites your subscription selects, go via VPN; everything else goes direct."
msgstr "Через VPN идут только адреса и устройства ниже и сайты, выбранные конфигурацией; остальное — напрямую."

msgid "Use a MAC address: it covers IPv4 and IPv6."
msgstr "Лучше указывать MAC-адрес — он действует и для IPv4, и для IPv6."

msgid "Cannot load the lists: %s"
msgstr "Не удалось загрузить списки: %s"

msgid "Reload the page to try again."
msgstr "Перезагрузите страницу, чтобы попробовать снова."

msgid "Not connected now: %s"
msgstr "Сейчас не подключены: %s"

msgid "Add as"
msgstr "Добавить как"

msgid "MAC (IPv4 + IPv6)"
msgstr "MAC (IPv4 + IPv6)"

msgid "IP address"
msgstr "IP-адрес"

msgid "%s (%s, private MAC)"
msgstr "%s (%s, частный MAC)"

msgid "Keep the device's private Wi-Fi address fixed for this network, or this rule will stop matching."
msgstr "Закрепите частный адрес Wi-Fi устройства для этой сети, иначе правило перестанет действовать."

msgid "Lists were saved, but settings could not be saved: %s. Review the settings and try Save & Apply again."
msgstr "Списки сохранены, но сохранить настройки не удалось: %s. Проверьте настройки и снова нажмите «Сохранить и применить»."

msgid "Changes applied."
msgstr "Изменения применены."

msgid "Last error: %s"
msgstr "Последняя ошибка: %s"

msgid "Other VPN packages are installed: %s"
msgstr "Установлены другие VPN-пакеты: %s"

msgid "These packages also change DNS and the firewall. Use only one VPN package at a time."
msgstr "Эти пакеты тоже меняют DNS и межсетевой экран. Одновременно используйте только один VPN-пакет."

msgid "Little free flash: %d MB"
msgstr "Мало свободной флеш-памяти: %d МБ"

msgid "Free some space or the core update may fail."
msgstr "Освободите место, иначе обновление ядра может не удаться."

msgid "Little free memory: %d MB"
msgstr "Мало свободной памяти: %d МБ"

msgid "B"
msgstr "Б"

msgid "KB"
msgstr "КБ"

msgid "MB"
msgstr "МБ"

msgid "GB"
msgstr "ГБ"

msgid "TB"
msgstr "ТБ"

msgid "%d MB"
msgstr "%d МБ"

msgid "Cannot load diagnostics: %s"
msgstr "Не удалось загрузить диагностику: %s"

msgid "XrayWRT is not running; this is what it would pass at start."
msgstr "XrayWRT не запущен; это то, что будет передано при запуске."

msgid "Cannot load the page: %s"
msgstr "Не удалось загрузить страницу: %s"

msgid "Try again"
msgstr "Повторить"

msgid "The subscription link uses plain http"
msgstr "Ссылка на подписку использует обычный http"

msgid "Anyone on the way can change your configuration. Ask your provider for an https link."
msgstr "При передаче конфигурацию могут подменить. Попросите у сервиса ссылку https://"

msgid "Automatic update"
msgstr "Автоматическое обновление"

msgid "Cancel"
msgstr "Отмена"

msgid "Update"
msgstr "Обновить"

msgid "XrayWRT restarts after the update; the internet drops for a few seconds."
msgstr "После обновления XrayWRT перезапустится — интернет пропадёт на несколько секунд."

msgid "Without a subscription XrayWRT starts with the current configuration; by default all traffic goes direct."
msgstr "Без подписки XrayWRT запустится с текущей конфигурацией: по умолчанию весь трафик идёт напрямую."

msgid "The upload failed. Check your LuCI permissions and try again."
msgstr "Не удалось загрузить файл. Проверьте права доступа в LuCI и попробуйте снова."

msgid "Nothing was changed, the previous configuration is still running."
msgstr "Ничего не изменено, работает прежняя конфигурация."

msgid "The downloaded core file is damaged. Try again."
msgstr "Скачанный файл ядра повреждён. Попробуйте ещё раз."

msgid "The core is already being updated."
msgstr "Обновление ядра уже выполняется."

msgid "There is no previous configuration."
msgstr "Предыдущей конфигурации нет."

msgid "The \"%s\" list is larger than 1 MiB."
msgstr "Список «%s» больше 1 МБ."

msgid "XrayWRT could not start. See the log on the Help page."
msgstr "XrayWRT не запустился. Подробности — в журнале на странице «Помощь»."

msgid "Failed to apply nftables policy: see %s. Restart XrayWRT; if it happens again, see the log on Help."
msgstr "Не удалось применить правила nftables: см. %s. Перезапустите XrayWRT; если повторится — см. журнал в «Помощи»."

msgid "Fix the configuration first (see the item above), then press Start on Home."
msgstr "Сначала исправьте конфигурацию (пункт выше), затем нажмите «Запустить» на странице «Главная»."

msgid "Press Start on Home."
msgstr "Нажмите «Запустить» на странице «Главная»."

msgid "XrayWRT is not running"
msgstr "Служба XrayWRT не работает"

msgid "Traffic rules are not active"
msgstr "Правила трафика не применены"

msgid "No problems found."
msgstr "Проблем не найдено."

msgid "%d problem found. Start with the first one."
msgid_plural "%d problems found. Start with the first one."
msgstr[0] "Найдена %d проблема. Начните с первой."
msgstr[1] "Найдено %d проблемы. Начните с первой."
msgstr[2] "Найдено %d проблем. Начните с первой."

msgid "Cannot load subscription settings: %s"
msgstr "Не удалось загрузить настройки подписки: %s"

msgid "Subscription updates, including automatic ones, replace your edits."
msgstr "Обновления подписки, включая автоматические, заменят ваши правки."

msgid "Stop using the subscription?"
msgstr "Отключить подписку?"

msgid "Disable"
msgstr "Отключить"

msgid "(%d in total)"
msgstr "(всего %d)"

msgid "Xray core update"
msgstr "Обновление ядра Xray"

msgid "Rule database update"
msgstr "Обновление баз правил"

msgid "Checking and applying the configuration"
msgstr "Проверка и применение конфигурации"

msgid "Restoring the previous configuration"
msgstr "Возврат предыдущей конфигурации"

msgid "Xray started, but the routing rules could not be applied: %s"
msgstr "Xray запущен, но правила маршрутизации не применились: %s"

msgid "The Xray core was updated, but XrayWRT could not restart: %s. Press Start on Home."
msgstr "Ядро Xray обновлено, но XrayWRT не перезапустился: %s. Нажмите «Запустить» на странице «Главная»."

msgid "Xray rejected the configuration."
msgstr "Xray не принял конфигурацию."

msgid "Not enough memory to check the configuration. Try again in a minute."
msgstr "Не хватает памяти, чтобы проверить конфигурацию. Повторите через минуту."

msgid "This link returns vless://, vmess://… links. Ask the service for an Xray JSON subscription link."
msgstr "Получены ссылки vless://, vmess://… Попросите у сервиса подписку Xray JSON."

msgid "This is Clash/Mihomo (YAML). Ask the service for an Xray JSON subscription link."
msgstr "Это Clash/Mihomo (YAML). Попросите у сервиса ссылку на подписку Xray JSON."

msgid "The configuration is not valid JSON."
msgstr "Ошибка в формате JSON."

msgid "The configuration has no outbounds."
msgstr "В конфигурации нет outbounds."

msgid "The configuration is invalid: %s"
msgstr "Конфигурация некорректна: %s"

msgid "The configuration needs %s, but the subscription does not supply it. Upload the file on the Updates page."
msgstr "Конфигурации нужен файл %s, но подписка его не даёт. Загрузите файл на странице «Обновления»."

msgid "The Xray core is not installed. Install it on the Updates page."
msgstr "Ядро Xray не установлено. Установите его на странице «Обновления»."

msgid "Not enough free flash for the Xray core: %s MiB needed, %s MiB free."
msgstr "Не хватает флеш-памяти для ядра Xray: нужно %s МБ, свободно %s МБ."

msgid "Not enough free memory to download the Xray core: %s MiB needed, %s MiB available."
msgstr "Не хватает оперативной памяти для загрузки ядра Xray: нужно %s МБ, доступно %s МБ."

msgid "The core file does not run on this router. The current core is kept."
msgstr "Файл ядра не запускается на этом роутере. Текущее ядро оставлено."

msgid "The configuration is empty: nothing was changed."
msgstr "Конфигурация пустая: ничего не изменено."

msgid "The configuration is larger than 8 MiB."
msgstr "Конфигурация больше 8 МБ."

msgid "XrayWRT settings are damaged. Save the Advanced page again or reinstall the package."
msgstr "Настройки XrayWRT повреждены. Сохраните страницу «Расширенные» ещё раз или переустановите пакет."

msgid "Configuration file not found: %s"
msgstr "Файл конфигурации не найден: %s"

msgid "Subscription updated; XrayWRT restarted."
