msgstr "Сохранённый закреплённый выход %s не применён."

msgid "Saved override %s is not applied: the configuration has no such balancer."
msgstr "Сохранённый закреплённый выход %s не применён: в конфигурации нет такого балансировщика."

msgid "Remove the saved override of %s"
msgstr "Удалить сохранённый закреплённый выход для %s"

msgid "Remove"
msgstr "Удалить"

msgid "As provider: %s"
msgstr "Как в конфигурации: %s"

