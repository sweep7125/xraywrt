msgstr "Добавить файл"

msgid "Use an HTTPS URL without spaces."
msgstr "Укажите ссылку HTTPS без пробелов."

msgid "Actions"
msgstr "Действия"

msgid "Geodata update schedule"
msgstr "Обновлять базы правил"

msgid "Applies only when the subscription sets no schedule of its own."
msgstr "Действует, только если подписка не задала своё расписание."

msgid "Every day at 05:00"
msgstr "Каждый день в 05:00"

msgid "Every 3 days at 05:00"
msgstr "Раз в 3 дня в 05:00"

msgid "Every week at 05:00"
msgstr "Раз в неделю в 05:00"

