# syntax=docker/dockerfile:1
FROM node:26-alpine

LABEL maintainer="XrayWRT Maintainers"
LABEL description="Native test runner container for XrayWRT"

# Install test tools natively for host architecture (no QEMU emulation required)
RUN apk add --no-cache \
    bash \
    coreutils \
    gawk \
    grep \
    jq \
    ucode \
    make \
    sed \
    shellcheck

# Pinned Go Xray core and geodata for tests that run the real core
# (`run -test`). TARGETARCH is unset by the classic builder: uname -m then. Test environment only: the product has no default geodata
# sources and no bundled core.
ARG TARGETARCH
ARG XRAY_TEST_TAG=v26.11.10-1249
ARG GEOIP_TAG=202611080027
ARG GEOSITE_TAG=20261116043813
RUN set -eu; \
    case "${TARGETARCH:-$(uname -m)}" in \
    amd64 | x86_64) asset=Xray-linux-64; sha=ece0cc805e063729a9a0fd3ee5e65b4a00c8e803daf5d1aed3fba7ea44d31ed3 ;; \
    arm64 | aarch64) asset=Xray-linux-arm64-v8a; sha=4fce6e8fba0d21a0e34e7beb24685bbd7a71f367fd426b877b9e3e0106139c18 ;; \
    *) echo "unsupported architecture ${TARGETARCH:-$(uname -m)}" >&2; exit 1 ;; \
    esac; \
    wget -q -O /usr/local/bin/xray-test "https://github.com/Jolymmiles/Xray-core/releases/download/$XRAY_TEST_TAG/$asset"; \
    echo "$sha  /usr/local/bin/xray-test" | sha256sum -c -; \
    chmod 755 /usr/local/bin/xray-test; \
    mkdir -p /usr/local/share/xray-test; \
    wget -q -O /usr/local/share/xray-test/geoip.dat "https://github.com/v2fly/geoip/releases/download/$GEOIP_TAG/geoip.dat"; \
    wget -q -O /usr/local/share/xray-test/geosite.dat "https://github.com/v2fly/domain-list-community/releases/download/$GEOSITE_TAG/dlc.dat"; \
    printf '%s  %s\n' \
        eedb24b3b9fcba27e06b92c0428dab90d9496083091ae4cf39e11387fd99d0e2 /usr/local/share/xray-test/geoip.dat \
        c449116a9ad4cf406a31c23ff254b94f4d341db0c2d5ad2924410daa62b4277b /usr/local/share/xray-test/geosite.dat | sha256sum -c -

WORKDIR /workspace

CMD ["/bin/bash", "tests/run.sh"]
